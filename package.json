{
  "name": "@raw-labs/oce-connections-plugin",
  "version": "0.3.1",
  "description": "OCE Connections service and provider-neutral CLI",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "RAW Labs SA",
    "url": "https://www.raw-labs.com"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.16.0"
  },
  "files": [
    "dist",
    "assets/catalog.json",
    "skills",
    "dev",
    "README.md",
    "RELEASING.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dependencies": {
    "@node-oauth/oauth2-server": "5.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.10.13",
    "esbuild": "0.27.4",
    "prettier": "3.9.7",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  },
  "scripts": {
    "check": "prettier --check . && tsc --noEmit && pnpm test",
    "test": "pnpm build && node --import tsx --test tests/*.test.ts",
    "build": "node scripts/build.mjs",
    "format": "prettier --write .",
    "artifact": "pnpm build && mkdir -p .local && npm pack --pack-destination .local",
    "inspect:package": "node scripts/inspect-package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raw-labs/oce-connections-plugin.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
